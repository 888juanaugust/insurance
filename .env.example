# Copy to .env.production on the server and fill in.

# Signs nothing any more — sessions live in the database — but the app still
# refuses to start in production without it, and the portal code hashing and
# the rest of the configuration checks key off the same discipline.
#   openssl rand -hex 32
IH_SECRET=

# SINGLE-AGENCY INSTALLS ONLY (with IH_TENANTS_DIR unset). Per-agency installs
# get their administrator from `npm run tenant -- create` instead.
#
# The first administrator, used ONCE: when the database is created on the
# first start. In production the seed will not create the demo accounts
# (whose password is in the repository); it creates this account instead, and
# refuses to create a database at all if neither this nor IH_SEED_DEMO is set.
# Ten characters or more, with a letter and a number. Remove both lines after
# the first start; they are not read again.
IH_ADMIN_EMAIL=
IH_ADMIN_PASSWORD=
# The agency's name, read at the same moment and shown in the top bar. Change
# it later under Team and agency → Company profile.
IH_AGENCY_NAME=
# Set to 1 to seed the demo accounts in production anyway. Do not.
# IH_SEED_DEMO=

# ONE AGENCY PER DATABASE.
#
# Set IH_TENANTS_DIR and each agency gets its own directory — its own SQLite
# file and its own documents — and its own Node process, pinned by IH_TENANT.
# PM2 reads this directory and starts one process per agency; nginx sends each
# subdomain to that agency's port. Create agencies with:
#
#   npm run tenant -- create --slug bs --name "BS Agency Sdn Bhd" \
#                            --admin "Boon Seng" --email owner@bs.my --password '...'
#
# Leave it commented out for a single-agency install, which uses IH_DB below.
# Uncommenting it is the whole switch: with it set, this process serves no
# agency until IH_TENANT names one, so do not set it until the agencies exist.
# IH_TENANTS_DIR=/var/lib/insurhelp/tenants

# The domain agencies are subdomains of: bs.insurhelp.my is the agency "bs".
# With it set, a request whose address names a different agency than the
# process serves is refused rather than answered out of the wrong book. Read
# only alongside IH_TENANTS_DIR; a single-agency install ignores it.
# IH_BASE_DOMAIN=insurhelp.my

# Set per process by PM2 from the tenants directory — not by hand here.
# IH_TENANT=bs

# Single-agency installs only: where the one SQLite file lives. Keep it outside
# the web root, on a path that survives redeploys, and make sure the app user
# can write to the directory. Ignored when IH_TENANTS_DIR is set.
IH_DB=/var/www/insurhelp/data/insurhelp.db

# Where uploaded policy documents are stored. Defaults to a `documents`
# directory beside the database. These are the PDFs the insurers issued — back
# them up with the database, not separately: a database restored without them
# has a policy register whose every attachment is a broken link.
IH_FILES=/var/www/insurhelp/data/documents

# Optional. Enables the model-assisted pass when reading policy PDFs whose
# layout the pattern rules do not cover. Without it, uploads still work and
# unknown layouts simply arrive with more blanks.
# Reading policy PDFs. Without this the upload uses pattern rules only: common
# Malaysian schedules come through, unfamiliar layouts come through with blanks,
# and a scanned document comes through empty. With it, a second pass reads the
# same document — including scans, which it reads as images — and the two are
# merged, with any disagreement flagged for a person rather than resolved
# silently.
ANTHROPIC_API_KEY=
# Optional: the model that pass uses. Defaults to claude-opus-5.
IH_EXTRACT_MODEL=

# Delivery for renewal notices. Without any of these, notices are still
# prepared and queued — they wait in the outbox for someone to send by hand,
# which is what a small agency does anyway. Set a URL to have Insurhelp send
# them: it POSTs {to, subject, text} with the token as a bearer.
# IH_WHATSAPP_URL=
# IH_WHATSAPP_TOKEN=
# IH_EMAIL_URL=
# IH_EMAIL_TOKEN=
# IH_SMS_URL=
# IH_SMS_TOKEN=

# Enables the daily scheduled run at /api/cron/renewal-notices. Without it the
# route refuses outright rather than running unauthenticated.
#   openssl rand -hex 32
# IH_CRON_SECRET=

# Optional. Pins "today" — useful for demos against the seeded data.
# IH_TODAY=2026-08-22
